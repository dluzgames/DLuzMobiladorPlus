<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="DLuz.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:DLuz.Views" xmlns:ctl="clr-namespace:DLuz.Controls" xmlns:services="clr-namespace:DLuz.Services" Title="DLuzMobiladorPlus" Icon="pack://application:,,,/Assets/logo.png" Width="1100" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" ShowInTaskbar="True" Background="{DynamicResource Stex.BgPrimaryBrush}" xmlns:dluz="clr-namespace:DLuz">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <Style x:Key="RailButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource Stex.TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bg" Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="12,9">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bg" Value="{DynamicResource Stex.AccentHoverBgBrush}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="RailChevron" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Stex.BgPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Stex.TextSecondaryBrush}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bg" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource Stex.AccentLightBrush}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="DLuzMobiladorPlus">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Banner de Notificação de Auto-Update (1-Clique) -->
    <Border Grid.Row="1" Background="{DynamicResource Stex.InfoSubtleBrush}" BorderBrush="{DynamicResource Stex.InfoBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8"
            Visibility="{Binding IsUpdateAvailable, Source={x:Static services:UpdateService.Instance}, Converter={StaticResource BoolToVis}}">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource Stex.AccentLightBrush}" Margin="0,0,10,0"/>
          <TextBlock Text="🚀 Nova versão disponível: " FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding NewVersion, Source={x:Static services:UpdateService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource Stex.SuccessBrush}" VerticalAlignment="Center"/>
          <TextBlock Text=" • " Foreground="{DynamicResource Stex.TextMutedBrush}" VerticalAlignment="Center" Margin="6,0"/>
          <TextBlock Text="{Binding Changelog, Source={x:Static services:UpdateService.Instance}}" FontSize="11.5" Foreground="{DynamicResource Stex.TextSecondaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <ui:Button HorizontalAlignment="Right" Content="⚡ Atualizar Agora (1-Clique)" Appearance="Primary" Padding="12,4" FontWeight="Bold" FontSize="11"
                   Command="{Binding AtualizarCommand, Source={x:Static services:UpdateService.Instance}}"/>
      </Grid>
    </Border>

    <Grid Row="2" Background="{DynamicResource Stex.BgPrimaryBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource Stex.BgDarkMidBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="0,0,1,0" Padding="18,24,14,18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="6,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="DLuz Mobilador" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Painel de Controle" Margin="0,2,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Stex.AccentLightBrush}" />
            </StackPanel>
            <ui:Button x:Name="BtnToggleTema" Grid.Column="1" VerticalAlignment="Center" Padding="6,6" CornerRadius="8"
                       ToolTip="Alternar Modo Claro / Escuro" Appearance="Secondary" Background="{DynamicResource Stex.BgSecondaryBrush}"
                       BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" Click="BtnToggleTema_Click">
              <ui:SymbolIcon x:Name="IconToggleTema" Symbol="WeatherSunny24" FontSize="16" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            </ui:Button>
          </Grid>
          <ScrollViewer Name="RailScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Name="RailContent">
              <StackPanel Name="RailItems" Orientation="Vertical" />
              <Canvas IsHitTestVisible="False">
                <Border Name="NavIndicator" Width="3" Height="0" CornerRadius="2" Visibility="Collapsed" Background="{DynamicResource Stex.AccentLightBrush}" />
              </Canvas>
            </Grid>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Border Height="200" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="1" Background="{DynamicResource Stex.BgDarkBrush}">
              <Image Source="pack://application:,,,/Assets/dluzmobi-sidebar.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Badge de Licença & Teste de 3 Dias -->
            <Border Margin="0,8,0,0" Padding="8,6" Background="{DynamicResource Stex.BgSecondaryBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="1" CornerRadius="6">
              <StackPanel>
                <TextBlock Text="{Binding StatusTexto, Source={x:Static services:LicenseService.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusBrush, Source={x:Static services:LicenseService.Instance}}" TextWrapping="Wrap" />
                <ui:Button Margin="0,6,0,0" Content="🔑 Ativar Licença Pro" Appearance="Primary" Padding="4,3" FontSize="10.5" HorizontalAlignment="Stretch" Click="AbrirModalAtivacao_Click" />
              </StackPanel>
            </Border>
            <TextBlock Text="Plus • Windows" Margin="8,6,0,0" FontSize="11" Foreground="{DynamicResource Stex.TextMutedBrush}" />
          </StackPanel>
          <Button Name="RailLeft" Visibility="Collapsed" Click="RailLeft_Click" />
          <Button Name="RailRight" Visibility="Collapsed" Click="RailRight_Click" />
        </Grid>
      </Border>
      <Grid Grid.Column="1" Background="{DynamicResource Stex.BgPrimaryBrush}">
        <ui:NavigationView Name="RootNav" PaneDisplayMode="Left" IsPaneVisible="False" OpenPaneLength="0" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False">
          <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Espelhar" TargetPageType="{x:Type views:InicioPage}" />
            <ui:NavigationViewItem Content="Modo DLuzStacks" TargetPageType="{x:Type views:MapeadorPage}" />
            <ui:NavigationViewItem Content="Modo OTG" TargetPageType="{x:Type views:ModoOtgPage}" />
            <ui:NavigationViewItem Content="Ajustes" TargetPageType="{x:Type views:AjustesPage}" />
            <ui:NavigationViewItem Content="Vídeo e Áudio" TargetPageType="{x:Type views:VideoPage}" />
            <ui:NavigationViewItem Content="Tela do celular" TargetPageType="{x:Type views:PantallaPage}" />
            <ui:NavigationViewItem Content="Conexão" TargetPageType="{x:Type views:ConexionPage}" />
            <ui:NavigationViewItem Content="Opções extras" TargetPageType="{x:Type views:ExtrasPage}" />
            <ui:NavigationViewItem Content="Controles" TargetPageType="{x:Type views:ControlesPage}" />
            <ui:NavigationViewItem Content="Otimização" TargetPageType="{x:Type views:OptimizacionPage}" />
            <ui:NavigationViewItem Content="Perfis" TargetPageType="{x:Type views:PerfilesPage}" />
            <ui:NavigationViewItem Content="Tutoriais" TargetPageType="{x:Type views:TutoriaisPage}" />
            <ui:NavigationViewItem Content="Informações" TargetPageType="{x:Type views:AcercaDePage}" />
          </ui:NavigationView.MenuItems>
        </ui:NavigationView>
        <ctl:DirtyBar x:Name="ShellDirtyBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="36,0,36,18" MaxWidth="920" />
      </Grid>
    </Grid>
    <ContentPresenter Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="2" />
    <ui:SnackbarPresenter Name="RootSnackbar" Grid.Row="1" MaxWidth="680" MinWidth="420" Margin="24,14,24,0" HorizontalAlignment="Center" VerticalAlignment="Top" />
  </Grid>
</ui:FluentWindow>








