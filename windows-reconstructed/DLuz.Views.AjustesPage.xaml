<Page x:Class="DLuz.Views.AjustesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:DLuz.Controls"
      xmlns:helpers="clr-namespace:DLuz.Helpers"
      xmlns:viewmodels="clr-namespace:DLuz.ViewModels"
      Title="Ajustes">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32" helpers:ScrollReset.ResetOnShow="True">
    <StackPanel>
      <TextBlock Text="Ajustes &amp; Mira Pro" Style="{StaticResource Stex.PageTitle}" />
      <TextBlock Text="Polling de 1000Hz (1ms), timer multimídia e aceleração/puxada de capa para Free Fire e jogos FPS."
                 Margin="0,4,0,20" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />

      <!-- Card 1: Polling Rate 1000Hz & Timer Multimídia -->
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
          <Grid>
            <StackPanel Width="440" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Flash24" Foreground="#38EF7D" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Taxa de Polling do Mouse (1000Hz / 1ms)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              </StackPanel>
              <TextBlock Text="Ativa o loop de 1ms com timer multimídia de alta resolução do Windows (timeBeginPeriod(1)), garantindo mira ultra-lisa e zero micro-travamentos para mouses gamer."
                         FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Polling1000Hz, Mode=TwoWay}" />
          </Grid>

          <Border Height="1" Margin="0,14" Background="{DynamicResource Stex.BorderNeutralBrush}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="Frequência do Mapeador" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Taxa de atualização dos eventos" FontSize="11.5" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="260"
                      ItemsSource="{Binding Frequencias}" SelectedItem="{Binding FrequenciaSelecionada, Mode=TwoWay}" />
          </Grid>

          <Grid Margin="0,14,0,0">
            <StackPanel Width="440" HorizontalAlignment="Left">
              <TextBlock Text="Timer Multimídia de Alta Precisão (1ms)" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Utiliza timeBeginPeriod(1u) nativo do kernel do Windows para evitar instabilidades de FPS do mouse." FontSize="11.5" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding TimerMultimidiaAtivo, Mode=TwoWay}" />
          </Grid>

          <Grid Margin="0,14,0,0">
            <StackPanel Width="440" HorizontalAlignment="Left">
              <TextBlock Text="Prioridade Máxima de Thread (Real-Time)" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Executa a thread do motor com ThreadPriority.Highest para latência mínima e resposta instantânea." FontSize="11.5" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding PrioridadeMaximaThread, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </ui:Card>

      <!-- Card 2: Aceleração & Puxada de Capa (Eixo Y) -->
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
          <Grid Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Target24" Foreground="#FF2A3A" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Aceleração &amp; Puxada de Capa (Eixo Y)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Botão de Ajuda ? -->
            <Border HorizontalAlignment="Right" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Stex.BtnSecondaryBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="1" Cursor="Hand" ToolTipService.ShowDuration="30000">
              <Border.ToolTip>
                <ToolTip Background="{DynamicResource Stex.BgSecondaryBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="1" Padding="16,14" MaxWidth="440">
                  <StackPanel>
                    <TextBlock Text="🎯 GUIA DE SENSIBILIDADE AVANÇADA &amp; CAPA" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Stex.SuccessBrush}" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="1. 🎯 Puxada de Capa (Eixo Y):" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Stex.AccentLightBrush}"/>
                    <TextBlock Text="• Multiplicador vertical inteligente ativo ao arrastar o mouse para cima." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextPrimaryBrush}"/>
                    <TextBlock Text="• Sobe a mira direto na cabeça no Free Fire sem afetar a mira lateral." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}"/>
                    <TextBlock Text="• Valores: 1.0 (1:1 Normal) | 1.30 a 1.40 (Equilibrado) | 1.80+ (Extrema / Rush)" FontSize="10.5" Foreground="{DynamicResource Stex.SuccessBrush}" Margin="0,1,0,8"/>

                    <TextBlock Text="2. ⚡ Aceleração Câmera:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Stex.InfoBrush}"/>
                    <TextBlock Text="• Ajusta a velocidade de giro pela rapidez do movimento da sua mão." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextPrimaryBrush}"/>
                    <TextBlock Text="• Lento = mira precisa de longe. Rápido = giro ágil de 180°/360°." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}"/>
                    <TextBlock Text="• Valores: 0.0 (RAW mecânico) | 0.6 a 1.1 (Free Fire / Gelo rápido)" FontSize="10.5" Foreground="{DynamicResource Stex.SuccessBrush}" Margin="0,1,0,8"/>

                    <TextBlock Text="3. 🛡️ Suavização (Anti-Tremor / Anti-Jitter):" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Stex.WarningBrush}"/>
                    <TextBlock Text="• Filtro que remove micro-tremores e ruídos do sensor do mouse." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextPrimaryBrush}"/>
                    <TextBlock Text="• Deixa a mira cravada e firme no adversário sem adicionar delay." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}"/>
                    <TextBlock Text="• Valores: 0.0 (Desligado) | 0.10 a 0.30 (Mira Lisa e Firme)" FontSize="10.5" Foreground="{DynamicResource Stex.SuccessBrush}" Margin="0,1,0,8"/>

                    <TextBlock Text="4. ⚡ Polling 1000Hz (1ms) Ativo:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Stex.SuccessBrush}"/>
                    <TextBlock Text="• Lê o mouse 1.000 vezes por segundo (1ms) via Windows Raw Input." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextPrimaryBrush}"/>
                    <TextBlock Text="• Latência zero, cliques instantâneos e máxima responsividade." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}"/>
                  </StackPanel>
                </ToolTip>
              </Border.ToolTip>
              <TextBlock Text="?" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Stex.TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
            </Border>
          </Grid>
          <TextBlock Text="Cálculo exponencial no CameraMapper.cs para subida de mira facilitada no Free Fire e FPS. Quanto maior o valor, mais fácil e leve fica a puxada de capa vertical sem perder o controle horizontal."
                     FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />

          <!-- Presets Rápidos de Sensibilidade -->
          <Border Background="{DynamicResource Stex.BgSecondaryBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="⚡ Presets Rápidos de Mira &amp; Puxada:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Stex.AccentLightBrush}" Margin="0,0,0,8" />
              <WrapPanel>
                <ui:Button Content="🎯 Padrão (Capa Equilibrado)" Command="{Binding PresetPadraoCommand}" Margin="0,0,8,6" Padding="12,6" FontWeight="SemiBold" />
                <ui:Button Content="🔥 Puxada Extrema (Capa Fácil)" Command="{Binding PresetCapaExtremoCommand}" Margin="0,0,8,6" Padding="12,6" FontWeight="SemiBold" />
                <ui:Button Content="🛡️ Precisão Competitiva (PUBG / CODM / CS)" Command="{Binding PresetPrecisaoCommand}" Margin="0,0,0,6" Padding="12,6" FontWeight="SemiBold" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Puxada de Capa Y -->
          <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="65" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Puxada de Capa (Eixo Y)" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Exponente Y exponencial" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <Slider x:Name="SliderPuxadaCapa" Grid.Column="1" Minimum="1.0" Maximum="2.5" SmallChange="0.01" LargeChange="0.05"
                    TickFrequency="0.01" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" VerticalAlignment="Center"
                    Value="{Binding PuxadaCapaY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#FF2A3A"
                       Text="{Binding Value, ElementName=SliderPuxadaCapa, StringFormat={}{0:F2}x}" />
          </Grid>

          <!-- Aceleração de Câmera -->
          <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="65" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Aceleração de Câmera" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Curva dinâmica de velocidade" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <Slider x:Name="SliderAceleracao" Grid.Column="1" Minimum="0.0" Maximum="1.5" SmallChange="0.01" LargeChange="0.05"
                    TickFrequency="0.01" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" VerticalAlignment="Center"
                    Value="{Binding AceleracaoCamera, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Stex.AccentLightBrush}"
                       Text="{Binding Value, ElementName=SliderAceleracao, StringFormat={}{0:F2}}" />
          </Grid>

          <!-- Sensibilidade X -->
          <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="65" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Sensibilidade Eixo X (Horizontal)" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Velocidade de giro lateral" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <Slider x:Name="SliderSensX" Grid.Column="1" Minimum="0.5" Maximum="8.0" SmallChange="0.1" LargeChange="0.5"
                    TickFrequency="0.1" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1" VerticalAlignment="Center"
                    Value="{Binding SensibilidadeX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}"
                       Text="{Binding Value, ElementName=SliderSensX, StringFormat={}{0:F1}}" />
          </Grid>

          <!-- Sensibilidade Y -->
          <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="65" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Sensibilidade Eixo Y (Vertical)" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Velocidade vertical base" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <Slider x:Name="SliderSensY" Grid.Column="1" Minimum="0.5" Maximum="8.0" SmallChange="0.1" LargeChange="0.5"
                    TickFrequency="0.1" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1" VerticalAlignment="Center"
                    Value="{Binding SensibilidadeY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}"
                       Text="{Binding Value, ElementName=SliderSensY, StringFormat={}{0:F1}}" />
          </Grid>

          <!-- Suavização de Mira -->
          <Grid Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="65" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Suavização de Mira (Anti-Tremor)" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Filtro anti-ruído do sensor" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <Slider x:Name="SliderSuavizacao" Grid.Column="1" Minimum="0.0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                    TickFrequency="0.01" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" VerticalAlignment="Center"
                    Value="{Binding SuavizacaoMira, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}"
                       Text="{Binding Value, ElementName=SliderSuavizacao, StringFormat={}{0:F2}}" />
          </Grid>
        </StackPanel>
      </ui:Card>

      <!-- Card: Aparência & Tema da Interface -->
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="WeatherMoon24" Foreground="{DynamicResource Stex.AccentLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Aparência &amp; Tema da Interface" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              </StackPanel>
              <TextBlock Text="Escolha entre o Tema Escuro (Modern Studio — Obsidian Slate) e o Tema Claro (Soft Light — Confortável para os olhos)."
                         Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button x:Name="BtnTemaEscuro" Content="🌙 Modo Escuro" Appearance="Secondary" Margin="0,0,8,0" Padding="14,8" FontWeight="SemiBold" Click="BtnTemaEscuro_Click" />
              <ui:Button x:Name="BtnTemaClaro" Content="☀️ Modo Claro" Appearance="Secondary" Padding="14,8" FontWeight="SemiBold" Click="BtnTemaClaro_Click" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:Card>

      <!-- Card 3: Testador de Taxa de Frequência do Mouse em Tempo Real -->
      <ui:Card Margin="0,0,0,20" Padding="20,18">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Monitor de Polling Rate em Tempo Real" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="{Binding TestadorStatus}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Stex.SuccessSubtleBrush}" BorderBrush="{DynamicResource Stex.SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding HzAtual, StringFormat={}{0:F0}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Stex.SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text=" Hz" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,2,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ui:Card>

      <!-- Botão Restaurar Padrões -->
      <ui:Button Content="🔄 Restaurar Padrões Competitivos" HorizontalAlignment="Left" Appearance="Secondary"
                 Command="{Binding RestaurarPadroesCommand}" Padding="16,8" FontWeight="SemiBold" />
    </StackPanel>
  </ScrollViewer>
</Page>
