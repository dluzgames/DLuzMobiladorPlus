<Page x:Class="DLuz.Views.TutoriaisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:DLuz.ViewModels"
      xmlns:helpers="clr-namespace:DLuz.Helpers"
      mc:Ignorable="d"
      Title="Central de Tutoriais &amp; Aulas">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
    <StackPanel>

      <!-- Banner de Destaque: Academia DLuzMobilador -->
      <Border Margin="0,0,0,24" Padding="28,24" CornerRadius="12">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16264A" Offset="0" />
            <GradientStop Color="#0C1428" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:SymbolIcon Symbol="VideoClip24" FontSize="28" Foreground="#FF3D71" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="Central de Tutoriais &amp; Aulas Práticas" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
              <Border Background="#1C2B52" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="12" Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Guia Passo a Passo em Vídeo" FontSize="11" FontWeight="Bold" Foreground="#00E676" />
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Text="Aprenda em vídeos rápidos e diretos de 2 a 3 minutos como configurar seu celular, ativar a depuração, calibrar a melhor sensibilidade de capa e dominar o mapeador!" FontSize="13.5" TextWrapping="Wrap" Foreground="#CAD4F5" />
          </StackPanel>

          <!-- Botão Playlist Oficial -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
            <ui:Button Content="▶ Playlist no YouTube" Appearance="Primary" Height="42" Padding="18,0" FontWeight="Bold" Command="{Binding AbrirPlaylistCommand}" Icon="{ui:SymbolIcon Play24}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Lista de Mini-Aulas por Módulo -->
      <TextBlock Text="📚 Módulos &amp; Aulas Disponíveis" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Margin="0,0,0,14" />

      <ItemsControl ItemsSource="{Binding Tutoriais}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:TutorialItem}">
            <ui:Card Margin="0,0,0,14" Padding="20,16" Background="#161B36" BorderBrush="{DynamicResource Stex.BorderSecondaryBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Número da Aula com Gradiente -->
                <Border Grid.Column="0" Width="60" Height="60" CornerRadius="10" Background="#0F1428" BorderBrush="#26345C" BorderThickness="1" VerticalAlignment="Center">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="AULA" FontSize="9" FontWeight="Bold" Foreground="#8896C2" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Numero}" FontSize="20" FontWeight="Bold" Foreground="#00E676" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Informações e Título -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Background="#1E2A4A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Categoria}" FontSize="10" FontWeight="Bold" Foreground="{Binding TagCor}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="Timer24" FontSize="11" Foreground="#8E9ABF" VerticalAlignment="Center" Margin="0,0,3,0" />
                      <TextBlock Text="{Binding Duracao}" FontSize="11.5" Foreground="#8E9ABF" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,0,0,4" />
                  <TextBlock Text="{Binding Descricao}" FontSize="12.5" Foreground="#9DAACF" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Botão Assistir Aula -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                  <ui:Button Content="Assistir Aula" Appearance="Primary" Height="38" Padding="14,0" FontWeight="SemiBold"
                             Command="{Binding DataContext.AbrirTutorialCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                             CommandParameter="{Binding}"
                             Icon="{ui:SymbolIcon Play24}" />
                </StackPanel>
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Dúvidas & Suporte -->
      <Border Margin="0,10,0,0" Padding="20,16" CornerRadius="10" Background="#14182E" BorderBrush="#252F52" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="💬 Ficou com alguma dúvida ou precisa de ajuda técnica?" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,3" />
            <TextBlock Text="Nossa equipe está pronta para te atender e tirar qualquer dúvida sobre configuração ou aparelhos." FontSize="12" Foreground="#8E9ABF" />
          </StackPanel>
          <ui:Button Grid.Column="1" Content="Chamar no Suporte VIP" Appearance="Secondary" Height="36" Command="{Binding AbrirSuporteCommand}" Margin="16,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon Chat24}" />
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
