<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DLuz.Views.ConexionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:DLuz.Controls" xmlns:helpers="clr-namespace:DLuz.Helpers" Title="Conexão" xmlns:views="clr-namespace:DLuz.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32" helpers:ScrollReset.ResetOnShow="True">
    <StackPanel>
      <TextBlock Text="Conexão" Style="{StaticResource Stex.PageTitle}" />
                <TextBlock Text="Estado do ADB, modo OTG e conexão Wi-Fi." Margin="0,4,0,16" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <ctl:KofiCta Text="Precisa de ajuda para conectar seu aparelho? Confira as opções no Ko-fi" />
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
                        <TextBlock Text="Estado da conexão ADB" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
          <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding AdbEstadoTexto}" Foreground="{Binding AdbEstadoBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <ui:Button Content="Reiniciar ADB" Appearance="Primary" Command="{Binding ReiniciarAdbCommand}" Icon="{ui:SymbolIcon ArrowSync24}" />
            <ui:Button Content="Limpiar WiFi Huérfanas" Margin="10,0,0,0" Command="{Binding LimpiarHuerfanasCommand}" Icon="{ui:SymbolIcon Broom24}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
          <Border Background="{DynamicResource Stex.AccentHoverBgBrush}" BorderBrush="{DynamicResource Stex.AccentBorderPenBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,14" Visibility="{Binding OtgSesionVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Stex.AccentTextBrush}" Text="{Binding OtgSesionTexto}" />
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                        <TextBlock Text="Modo OTG (teclado e mouse)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                        <TextBlock Text="Controle total do celular por teclado e mouse físicos. Não inclui transmissão de vídeo ou áudio." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" FontSize="12" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" ToolTip="OTG solo funciona por USB. Desactiva WiFi primero." IsChecked="{Binding OtgActivo, Mode=TwoWay}" IsEnabled="{Binding OtgHabilitado}" />
          </Grid>
                        <TextBlock Text="Dispositivo USB:" Margin="0,14,0,4" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Seriales}" SelectedItem="{Binding SelectedSerial, Mode=TwoWay}" />
          <Border Background="{DynamicResource Stex.BgDarkMidBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Stex.SuccessBrightBrush}" Text="{Binding OtgConsolaTexto}" />
          </Border>
                        <ui:Button Content="Detectar dispositivos" Appearance="Primary" Margin="0,12,0,0" Command="{Binding DetectarOtgCommand}" Icon="{ui:SymbolIcon ArrowSync24}" />
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
          <Border Background="{DynamicResource Stex.AccentHoverBgBrush}" BorderBrush="{DynamicResource Stex.AccentBorderPenBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,14" Visibility="{Binding WifiSesionVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Stex.AccentTextBrush}" Text="{Binding WifiSesionTexto}" />
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                        <TextBlock Text="Conexão Wi-Fi (recomendada)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                        <TextBlock Text="① Conecte o cabo USB    ② Ative o Wi-Fi    ③ Habilite a porta    ④ Conecte" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Stex.AccentSubtleBrush}" FontSize="12" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding WifiActivo, Mode=TwoWay}" />
          </Grid>
          <TextBlock Text="Use somente em redes privadas, nunca em redes públicas." Margin="0,10,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Stex.WarningBrush}" />
          <Border Margin="0,16,0,4" Padding="16" CornerRadius="10" Background="{DynamicResource Stex.BgDarkMidBrush}" BorderBrush="{DynamicResource Stex.AccentBorderPenBrush}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="190" Height="190" Padding="8" CornerRadius="8" Background="White" HorizontalAlignment="Left">
                <Image Source="{Binding QrCodeImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
              </Border>
              <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Pareamento por QR Code (Android 11+)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="1. Clique em Iniciar espera.  2. No celular, abra Opções do desenvolvedor › Depuração sem fio.  3. Toque em Parear dispositivo com QR Code e escaneie a imagem." />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Stex.AccentLightBrush}" Text="{Binding QrStatusTexto}" />
                <WrapPanel Margin="0,14,0,0">
                  <ui:Button Content="Novo QR Code" Margin="0,0,10,0" Command="{Binding NovoQrCommand}" IsEnabled="{Binding QrBotoesHabilitados}" Icon="{ui:SymbolIcon QrCode24}" />
                  <ui:Button Content="Iniciar espera" Appearance="Primary" Command="{Binding IniciarPareamentoQrCommand}" IsEnabled="{Binding QrBotoesHabilitados}" Icon="{ui:SymbolIcon Wifi124}" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border Margin="0,10,0,4" Padding="14" CornerRadius="10" Background="{DynamicResource Stex.BgDarkMid2Brush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Pareamento Manual por Código (Android 11+)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Text="Caso prefira, abra Depuração sem fio › 'Parear com código de pareamento' e digite os dados abaixo:" Margin="0,4,0,8" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <WrapPanel>
                <StackPanel Margin="0,0,10,6">
                  <TextBlock Text="IP do Pareamento:" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                  <ui:TextBox Width="150" PlaceholderText="192.168.1.X" Text="{Binding PairIp, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                  <TextBlock Text="Porta do Pareamento:" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                  <ui:TextBox Width="90" PlaceholderText="37000" Text="{Binding PairPorta, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                  <TextBlock Text="Código (6 dígitos):" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                  <ui:TextBox Width="120" PlaceholderText="123456" Text="{Binding PairCodigo, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <ui:Button Content="Parear por Código" VerticalAlignment="Bottom" Margin="0,0,0,6" Command="{Binding ParearManualCommand}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Appearance="Primary" />
              </WrapPanel>
              <TextBlock Text="{Binding PairManualStatus}" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Stex.AccentLightBrush}" />
            </StackPanel>
          </Border>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Porta:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <ui:TextBox Grid.Column="1" MaxLength="5" Text="{Binding Puerto, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
                        <TextBlock Text="IP do aparelho:" Margin="0,12,0,4" FontWeight="SemiBold" Foreground="{DynamicResource Stex.AccentLightBrush}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="192.168.1.X" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" ToolTip="Detectar IP" Command="{Binding DetectarIpCommand}" IsEnabled="{Binding DetectarIpHabilitado}" Icon="{ui:SymbolIcon ArrowSync24}" />
          </Grid>
          <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,0" Text="{Binding WifiStatusTexto}" Foreground="{Binding WifiStatusBrush}" />
          <WrapPanel Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Margin="0,0,10,10" Content="{Binding HabilitarPuertoTexto}" Command="{Binding HabilitarPuertoCommand}" IsEnabled="{Binding HabilitarPuertoHabilitado}" Icon="{ui:SymbolIcon Wifi124}" />
            <ui:Button Margin="0,0,10,10" Content="{Binding ConectarWifiTexto}" Command="{Binding ConectarWifiCommand}" IsEnabled="{Binding ConectarWifiHabilitado}" Icon="{ui:SymbolIcon PlugConnected24}" />
                            <ui:Button Content="Fechar porta" Appearance="Danger" Margin="0,0,0,10" Command="{Binding CerrarPuertoCommand}" IsEnabled="{Binding CerrarPuertoHabilitado}" Icon="{ui:SymbolIcon PlugDisconnected24}" />
          </WrapPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</Page>


