<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DLuz.Views.PerfilesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:DLuz.ViewModels" xmlns:ctl="clr-namespace:DLuz.Controls" xmlns:helpers="clr-namespace:DLuz.Helpers" Title="Perfis" xmlns:views="clr-namespace:DLuz.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="32,24,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Perfis" Style="{StaticResource Stex.PageTitle}" />
                <TextBlock Text="Crie, carregue, salve, importe e exporte perfis." Margin="0,4,0,16" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <ctl:KofiCta Text="Precisa de um perfil personalizado? Disponível no Ko-fi" />
    </StackPanel>
    <TabControl Grid.Row="1" Background="#00FFFFFF" BorderThickness="0">
      <TabItem Header="Perfis USB / Wi-Fi">
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:Card Grid.Column="0" Margin="0,0,16,0" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Perfis salvos" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
          <ListBox Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ItemsSource="{Binding Perfiles}" SelectedItem="{Binding SelectedPerfil, Mode=TwoWay}" />
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <ui:Button Content="Novo a partir do estado atual" Appearance="Primary" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon AddCircle24}" Command="{Binding NuevoPerfilCommand}" />
            <ui:Button Content="Crear desde cero" Margin="0,8,0,0" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon DocumentAdd24}" Command="{Binding CrearDesdeCeroCommand}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0" Content="Importar" Margin="0,0,4,0" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportarCommand}" />
              <ui:Button Grid.Column="1" Content="Exportar" Margin="4,0,0,0" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowExport24}" Command="{Binding ExportarListaCommand}" />
            </Grid>
                            <ui:Button Content="Restaurar perfis oficiais" Margin="0,8,0,0" HorizontalAlignment="Stretch" ToolTip="Cria um backup e restaura os sete perfis oficiais. Seus perfis personalizados não serão alterados." Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding RestaurarBaseCommand}" />
          </StackPanel>
        </Grid>
      </ui:Card>
      <ui:Card Grid.Column="1" Padding="0">
        <Grid MinWidth="420">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Visibility="{Binding ListaVacia, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="DocumentDismiss24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                                <TextBlock Text="Não há perfis disponíveis." FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                                <TextBlock Text="Crie um novo perfil ou restaure os perfis oficiais." Margin="0,0,0,18" HorizontalAlignment="Center" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                                <ui:Button Content="Criar perfil do zero" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentAdd24}" Command="{Binding CrearDesdeCeroCommand}" />
                                <ui:Button Content="Restaurar perfis oficiais" HorizontalAlignment="Stretch" Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding RestaurarBaseCommand}" />
            <ui:Button Content="Importar perfil" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportarCommand}" />
          </StackPanel>
          <Grid Visibility="{Binding DetalleVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,18,20,8">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border CornerRadius="10" Padding="9,2" VerticalAlignment="Center" Background="{DynamicResource Stex.BtnSecondaryBrush}" BorderBrush="{DynamicResource Stex.AccentLightBrush}" BorderThickness="1">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Stex.AccentLightBrush}" Text="{Binding TipoEtiqueta}" />
                </Border>
                <Border CornerRadius="10" Padding="9,2" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Stex.BtnSecondaryBrush}" Visibility="{Binding OrigenVisible, Converter={StaticResource BoolToVis}}">
                  <TextBlock FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding OrigenEtiqueta}" />
                </Border>
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding ModificadoEtiqueta}" />
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Nombre" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <ui:TextBox Grid.Column="1" HorizontalAlignment="Left" Width="320" Text="{Binding NombreEditable, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
              <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Stex.ErrorBrush}" Text="{Binding NombreError}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" Padding="20,0" VerticalScrollBarVisibility="Auto" helpers:ScrollReset.ResetOnShow="True">
              <StackPanel>
                                <TextBlock Text="Valores do perfil" FontWeight="SemiBold" Margin="0,10,0,8" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <ItemsControl ItemsSource="{Binding Valores}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PerfilValor}">
                      <StackPanel Orientation="Horizontal" Margin="0,3,12,3">
                        <TextBlock Width="78" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding Nombre}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Valor}" Foreground="{Binding Color}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Puntos de restauración" FontWeight="SemiBold" Margin="0,16,0,6" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
      <TextBlock Text="Ainda não há pontos de restauração." FontSize="12" FontStyle="Italic" Margin="0,0,0,8" Foreground="{DynamicResource Stex.TextSecondaryBrush}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding HayPuntos}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding PuntosRestauracion}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PuntoRestauracionItem}">
                      <ui:Button Margin="0,0,8,8" Content="{Binding Etiqueta}" Icon="{ui:SymbolIcon History24}" CommandParameter="{Binding Indice}" Command="{Binding DataContext.RestaurarPuntoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource Stex.BgCardBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="0,1,0,0">
              <Grid>
                <WrapPanel Visibility="{Binding EsBase, Converter={StaticResource BoolToVis}}">
                                    <ui:Button Content="Salvar alterações" Appearance="Primary" Margin="0,0,8,4" Icon="{ui:SymbolIcon Save24}" Command="{Binding GuardarCommand}" />
                                    <ui:Button Content="Desfazer alterações" Margin="0,0,8,4" ToolTip="Descarta as alterações não salvas e retorna ao último estado salvo." Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RevertirCambiosCommand}" />
                  <ui:Button Content="Restaurar perfil oficial" Margin="0,0,8,4" ToolTip="Hace backup y devuelve solo este perfil oficial a sus valores originales." Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding RestaurarEsteBaseCommand}" />
                  <ui:Button Content="Duplicar" Margin="0,0,8,4" ToolTip="Crea un perfil personalizado a partir de este oficial." Icon="{ui:SymbolIcon Copy24}" Command="{Binding DuplicarCommand}" />
                                    <ui:Button Content="Excluir" Appearance="Danger" Margin="0,0,8,4" Icon="{ui:SymbolIcon Delete24}" Command="{Binding EliminarCommand}" />
                  <ui:Button Content="Exportar" Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowExport24}" Command="{Binding ExportarCommand}" />
                </WrapPanel>
                <WrapPanel Visibility="{Binding EsPersonalizado, Converter={StaticResource BoolToVis}}">
                                    <ui:Button Content="Salvar alterações" Appearance="Primary" Margin="0,0,8,4" Icon="{ui:SymbolIcon Save24}" Command="{Binding GuardarCommand}" />
                                    <ui:Button Content="Desfazer alterações" Margin="0,0,8,4" ToolTip="Descarta as alterações não salvas e retorna ao último estado salvo." Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RevertirCambiosCommand}" />
                  <ui:Button Content="Restaurar desde origen" Margin="0,0,8,4" ToolTip="Reemplaza este perfil con los valores de su perfil base de origen." Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding RestaurarDesdeOrigenCommand}" Visibility="{Binding PuedeRestaurarOrigen, Converter={StaticResource BoolToVis}}" />
                  <ui:Button Content="Duplicar" Margin="0,0,8,4" Icon="{ui:SymbolIcon Copy24}" Command="{Binding DuplicarCommand}" />
                                    <ui:Button Content="Excluir" Appearance="Danger" Margin="0,0,8,4" Icon="{ui:SymbolIcon Delete24}" Command="{Binding EliminarCommand}" />
                  <ui:Button Content="Exportar" Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowExport24}" Command="{Binding ExportarCommand}" />
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </ui:Card>
    </Grid>
      </TabItem>
      <TabItem Header="Desempenho">
        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Stex.BgPrimaryBrush}">
          <StackPanel Margin="28,24,28,30">
            <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Margin="0,0,0,24" />
          <Grid MaxWidth="850" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,32,0">
              <Border BorderBrush="{DynamicResource Stex.AccentLightBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,7">
                <TextBlock Text="Desempenho" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              </Border>
              <TextBlock Text="Visualização" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Gráficos" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Configurações do jogo" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Dispositivos" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Controle" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Preferências" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Telefone" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Atalhos" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Dados do usuário" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Avançado" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Sobre" Margin="0,13,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Width="520" HorizontalAlignment="Left">
              <TextBlock Text="Alocação de CPU" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <ComboBox Name="ComboCpuDesempenho" Width="220" HorizontalAlignment="Left" Margin="0,9,0,0" SelectedIndex="2">
                <ComboBoxItem Content="Baixo (1 núcleo)" Tag="1" />
                <ComboBoxItem Content="Médio (2 núcleos)" Tag="2" />
                <ComboBoxItem Content="Alto (4 núcleos)" Tag="4" />
                <ComboBoxItem Content="Máximo (8 núcleos)" Tag="8" />
              </ComboBox>
              <Separator Margin="0,16,0,16" Background="{DynamicResource Stex.BorderNeutralBrush}" />

              <TextBlock Text="Alocação de memória" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <ComboBox Name="ComboMemoriaDesempenho" Width="220" HorizontalAlignment="Left" Margin="0,9,0,0" SelectedIndex="2">
                <ComboBoxItem Content="1 GB (Econômico)" Tag="1024" />
                <ComboBoxItem Content="2 GB (Básico)" Tag="2048" />
                <ComboBoxItem Content="4 GB (Aprimorado)" Tag="4096" />
                <ComboBoxItem Content="8 GB (Alto)" Tag="8192" />
              </ComboBox>
              <Separator Margin="0,16,0,16" Background="{DynamicResource Stex.BorderNeutralBrush}" />

              <TextBlock Text="Modo de desempenho  ⓘ" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <ComboBox Name="ComboModoDesempenho" Width="220" HorizontalAlignment="Left" Margin="0,9,0,0" SelectedIndex="0">
                <ComboBoxItem Content="Equilibrado" Tag="balanced" />
                <ComboBoxItem Content="Alta performance" Tag="high" />
                <ComboBoxItem Content="Memória baixa" Tag="low_memory" />
              </ComboBox>
              <TextBlock Name="TxtTituloModoDesempenho" Text="Equilibrado" Visibility="Collapsed" />
              <TextBlock Name="TxtDescricaoModoDesempenho" Text="Mantém um equilíbrio entre qualidade, fluidez e uso de memória." Visibility="Collapsed" />
              <Separator Margin="0,16,0,16" Background="{DynamicResource Stex.BorderNeutralBrush}" />

              <TextBlock Name="TxtFpsDesempenho" Text="Taxa de quadros: 60" FontSize="14" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <Slider Name="SliderFpsDesempenho" Minimum="1" Maximum="240" Value="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" />
              <Grid Margin="0,0,0,0">
                <TextBlock Text="1" HorizontalAlignment="Left" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <TextBlock Text="240" HorizontalAlignment="Right" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              </Grid>
              <TextBlock Text="FPS recomendado" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="Use 60 FPS para uma jogabilidade suave. Taxas maiores exigem mais do computador e do aparelho conectado." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />

              <Grid Margin="0,14,0,0">
                <TextBlock Text="Ativar taxas de quadros altas" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <ui:ToggleSwitch Name="ToggleFpsAlto" HorizontalAlignment="Right" IsChecked="True" />
              </Grid>
              <Grid Margin="0,8,0,0">
                <TextBlock Text="Habilitar VSync (evita cortes na imagem)" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <ui:ToggleSwitch Name="ToggleVsync" HorizontalAlignment="Right" IsChecked="False" />
              </Grid>
              <Grid Margin="0,8,0,0">
                <TextBlock Text="Mostrar FPS durante o jogo" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <ui:ToggleSwitch Name="ToggleMostrarFps" HorizontalAlignment="Right" IsChecked="True" />
              </Grid>

              <Grid Margin="0,32,0,0">
                <TextBlock Text="ⓘ As mudanças serão aplicadas na próxima inicialização do espelhamento." FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <ui:Button Name="BtnSalvarModoDesempenho" Content="Salvar mudanças" Appearance="Primary" Width="170" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Save24}" />
              </Grid>
            </StackPanel>
          </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Page>

