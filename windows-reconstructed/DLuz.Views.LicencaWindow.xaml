<ui:FluentWindow x:Class="DLuz.Views.LicencaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:DLuz.Services"
        Title="Licença e Teste Grátis - DLuzMobiladorPlus"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        ResizeMode="NoResize"
        Background="{DynamicResource Stex.BgPrimaryBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <ui:TitleBar Grid.Row="0" Title="Ativação de Licença" />

    <Border Grid.Row="1" Padding="24,16,24,24">
      <StackPanel VerticalAlignment="Center">
        <!-- Logo e Título -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
          <Image Source="pack://application:,,,/Assets/logo.png" Width="36" Height="36" Margin="0,0,10,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DLuzMobiladorPlus" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}"/>
            <TextBlock Text="Sistema de Licenciamento &amp; HWID Lock" FontSize="11" Foreground="{DynamicResource Stex.AccentLightBrush}"/>
          </StackPanel>
        </StackPanel>

        <!-- Status Card -->
        <Border Background="{DynamicResource Stex.BgSecondaryBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
          <StackPanel>
            <Grid>
              <TextBlock Text="Status do seu Acesso:" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}"/>
              <TextBlock HorizontalAlignment="Right" Text="{Binding StatusTexto, Source={x:Static services:LicenseService.Instance}}" FontWeight="Bold" FontSize="12" Foreground="{Binding StatusBrush, Source={x:Static services:LicenseService.Instance}}"/>
            </Grid>
            
            <Separator Margin="0,8" Background="{DynamicResource Stex.BorderNeutralBrush}"/>
            
            <TextBlock Text="HWID deste Computador (Hardware Lock):" FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}"/>
            <Grid Margin="0,4,0,0">
              <TextBox Name="TxtHwid" IsReadOnly="True" Text="{Binding Hwid, Source={x:Static services:LicenseService.Instance}, Mode=OneTime}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="8,4" Background="{DynamicResource Stex.BgDarkBrush}" Foreground="{DynamicResource Stex.SuccessBrush}" BorderBrush="{DynamicResource Stex.BorderNeutralBrush}"/>
              <ui:Button HorizontalAlignment="Right" Content="Copiar" Padding="8,2" Margin="2" Click="BtnCopiarHwid_Click"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Campo de Inserir Chave -->
        <TextBlock Text="Possui uma Chave de Licença Pro?" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Margin="0,0,0,6"/>
        <TextBox Name="TxtChave" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="10,8" Background="{DynamicResource Stex.BgSecondaryBrush}" Foreground="{DynamicResource Stex.TextPrimaryBrush}" BorderBrush="{DynamicResource Stex.AccentLightBrush}" TextChanged="TxtChave_TextChanged" />

        <TextBlock Name="TxtMsgResultado" Margin="0,6,0,0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Botões de Ação -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <ui:Button Grid.Column="0" Content="⚡ Ativar Chave Pro" Appearance="Primary" Padding="12,10" FontWeight="Bold" Click="BtnAtivar_Click" HorizontalAlignment="Stretch"/>
          <ui:Button Grid.Column="2" Content="🛒 Comprar Licença Pro" Padding="12,10" FontWeight="Bold" Click="BtnComprar_Click" HorizontalAlignment="Stretch"/>
        </Grid>

        <!-- Botão Membro YouTube -->
        <ui:Button Content="🔴 Seja Membro no YouTube (Chave Grátis Todo Mês)" Margin="0,10,0,0" Padding="12,9" FontWeight="SemiBold" Click="BtnMembroYoutube_Click" HorizontalAlignment="Stretch" Appearance="Secondary" Icon="{ui:SymbolIcon Play24}" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
