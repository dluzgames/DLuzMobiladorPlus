<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DLuz.Views.OptimizacionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:DLuz.ViewModels" xmlns:ctl="clr-namespace:DLuz.Controls" xmlns:helpers="clr-namespace:DLuz.Helpers" Title="Otimização" xmlns:views="clr-namespace:DLuz.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:OptToggleRow}}" DataType="{x:Type vm:OptToggleRow}">
        <Grid Margin="0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding Titulo}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding Desc}" />
            <TextBlock FontSize="11" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Stex.TextCommandBrush}" Text="{Binding CmdLabel, StringFormat=cmd: {0}}" />
          </StackPanel>
          <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding Habilitado}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:OptComboRow}}" DataType="{x:Type vm:OptComboRow}">
        <StackPanel Margin="0,8">
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding Titulo}" />
          <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding Desc}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ComboBox Width="170" ItemsSource="{Binding Opciones}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" IsEnabled="{Binding Habilitado}" />
            <ui:Button Content="Aplicar" Appearance="Primary" Margin="8,0,0,0" Command="{Binding AplicarCommand}" IsEnabled="{Binding Habilitado}" />
            <ui:Button Content="Restaurar" Margin="8,0,0,0" Command="{Binding ResetearCommand}" IsEnabled="{Binding Habilitado}" />
          </StackPanel>
          <TextBlock FontSize="11" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Stex.TextCommandBrush}" Text="{Binding CmdLabel, StringFormat=cmd: {0}}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:OptButtonRow}}" DataType="{x:Type vm:OptButtonRow}">
        <Grid Margin="0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding Titulo}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding Desc}" />
            <TextBlock FontSize="11" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Stex.TextCommandBrush}" Text="{Binding CmdLabel, StringFormat=cmd: {0}}" />
          </StackPanel>
          <ui:Button Grid.Column="1" Appearance="Primary" VerticalAlignment="Center" Width="140" Content="{Binding BotonTexto}" Command="{Binding EjecutarCommand}" IsEnabled="{Binding Habilitado}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:OptInfoRow}}" DataType="{x:Type vm:OptInfoRow}">
        <StackPanel Margin="0,8">
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding Titulo}" />
          <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding Desc}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:OptPackageRow}}" DataType="{x:Type vm:OptPackageRow}">
        <StackPanel Margin="0,8">
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding Titulo}" />
          <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding Desc}" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="com.ejemplo.app" Text="{Binding PackageText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Habilitado}" />
            <ui:Button Grid.Column="1" Content="Ver apps" Margin="8,0,0,0" Command="{Binding ListarCommand}" IsEnabled="{Binding Habilitado}" />
            <ui:Button Grid.Column="2" Appearance="Primary" Margin="8,0,0,0" Content="{Binding AplicarTexto}" Command="{Binding AplicarCommand}" IsEnabled="{Binding Habilitado}" />
            <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="{Binding RestaurarTexto}" Command="{Binding RestaurarCommand}" IsEnabled="{Binding Habilitado}" />
          </Grid>
          <TextBlock FontSize="11" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Stex.TextCommandBrush}" Text="{Binding CmdLabel, StringFormat=cmd: {0}}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:OptCard}}" DataType="{x:Type vm:OptCard}">
        <ui:Card Margin="0,0,0,16" Padding="20,16">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource Stex.AccentLightBrush}" Text="{Binding Titulo}" />
            <ItemsControl ItemsSource="{Binding Rows}" />
          </StackPanel>
        </ui:Card>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32" helpers:ScrollReset.ResetOnShow="True">
    <StackPanel>
      <TextBlock Text="Otimização" Style="{StaticResource Stex.PageTitle}" />
      <TextBlock Text="Ações ADB leves, reversíveis e dependentes do aparelho para Android moderno." Style="{StaticResource Stex.PageSubtitle}" />
      <ctl:KofiCta Text="Otimização guiada e personalizada disponível no Ko-fi" />
        <ui:Button Content="Reverter tudo" Margin="0,0,0,12" Icon="{ui:SymbolIcon History24}" Command="{Binding RevertirTodoCommand}" />
        <ui:InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Margin="0,0,0,8" Message="Há otimizações ativas. Conecte o celular para revertê-las." Visibility="{Binding AdvertenciaVisible, Converter={StaticResource BoolToVis}}" />
        <ui:InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Margin="0,0,0,12" Message="Nenhum aparelho foi detectado. Verifique a conexão USB e a depuração USB." Visibility="{Binding NoDispositivoVisible, Converter={StaticResource BoolToVis}}" />
      <!-- Modo Latência Ultra USB & Benchmark de Encoders -->
      <ui:Card Margin="0,0,0,16" Padding="20,18" Background="#4A121A" BorderBrush="{DynamicResource Stex.AccentLightBrush}" BorderThickness="1">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Flash24" VerticalAlignment="Center" Foreground="{DynamicResource Stex.AccentLightBrush}" />
            <TextBlock Text="Modo Latência Ultra USB (Zero Delay)" Margin="10,0,0,0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource Stex.AccentBrush}" VerticalAlignment="Center">
              <TextBlock Text="RECOMENDADO" FontSize="10" FontWeight="Bold" Foreground="White" />
            </Border>
          </StackPanel>
          <TextBlock Text="Configura automaticamente codec H.264 de baixa latência, buffer de vídeo 0ms, 120 FPS, resolução equilibrada e escalas de animação zeradas no Android para o menor tempo de resposta possível." Margin="0,8,0,14" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
          <WrapPanel>
            <ui:Button Content="⚡ Ativar Latência Ultra USB" Appearance="Primary" Margin="0,0,12,8" Command="{Binding LatenciaUltraCommand}" Icon="{ui:SymbolIcon Flash24}" />
            <ui:Button Content="🔍 Testar Encoders do Aparelho (Benchmark)" Margin="0,0,12,8" Command="{Binding TestarEncodersCommand}" Icon="{ui:SymbolIcon DesktopPulse24}" />
          </WrapPanel>
          <TextBlock Text="{Binding EncoderBenchmarkStatus}" Margin="0,6,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Stex.SuccessBrightBrush}" />
        </StackPanel>
      </ui:Card>
      <ItemsControl ItemsSource="{Binding Cards}" />
    </StackPanel>
  </ScrollViewer>
</Page>


