<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DLuz.Views.AcercaDePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:helpers="clr-namespace:DLuz.Helpers" Title="Informações" xmlns:views="clr-namespace:DLuz.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <Style x:Key="TileButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="224" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Stex.BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stex.BorderNeutralBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="10" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="16,14">
                <ContentPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource Stex.AccentHoverBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stex.AccentBorderPenBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="TileButtonScrcpy" TargetType="{x:Type Button}" BasedOn="{StaticResource TileButton}">
        <Setter Property="Background" Value="{DynamicResource Stex.AndroidGreenSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stex.AndroidGreenBorderBrush}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource Stex.AndroidGreenBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32" helpers:ScrollReset.ResetOnShow="True">
    <StackPanel>
      <TextBlock Text="Sobre o DLuzMObi v2" Style="{StaticResource Stex.PageTitle}" />
      <TextBlock Text="Canais oficiais e redes sociais da DLuz Games." Margin="0,4,0,16" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
      <Border Margin="0,0,0,16" CornerRadius="10" Padding="24,22" Background="{DynamicResource Stex.CtaBgBrush}" BorderBrush="{DynamicResource Stex.CtaBorderBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock FontSize="11" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding Edicion}" />
            <TextBlock Text="DLuzMObi v2" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border Background="{DynamicResource Stex.BgTabActiveBrush}" CornerRadius="10" Padding="10,3">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{DynamicResource Stex.SuccessBrightBrush}" />
                  <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Stex.AccentLighterBrush}" Text="{Binding Estado}" />
                </StackPanel>
              </Border>
              <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Stex.AccentLightBrush}" Text="{Binding BuildTexto}" />
            </StackPanel>
            <Border Margin="0,8,0,0" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Background="{DynamicResource Stex.AndroidGreenSubtleBrush}" BorderBrush="{DynamicResource Stex.AndroidGreenBorderBrush}" BorderThickness="1" Visibility="{Binding ScrcpyVersionVisible, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Bot24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Stex.AndroidGreenBrush}" />
                <TextBlock Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Stex.AndroidGreenBrush}">
                  <Run Text="Motor de espelhamento " /> <Run Text="{Binding ScrcpyVersionNumero, Mode=OneWay}" /></TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
          <Image Grid.Column="1" Width="96" Height="96" VerticalAlignment="Top" Source="pack://application:,,,/Assets/logo.png" Stretch="Uniform" />
        </Grid>
      </Border>
      <Button Margin="0,0,0,20" HorizontalContentAlignment="Stretch" Cursor="Hand" BorderThickness="0" Background="Transparent" CommandParameter="{x:Static helpers:AppLinks.ApoiarProjeto}" Command="{Binding AbrirUrlCommand}">
        <Button.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="ApoiarBg" CornerRadius="10" Padding="22,18" BorderBrush="{DynamicResource Stex.AccentLightBrush}" BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FF0C69BC" Offset="0" />
                  <GradientStop Color="#FF168FF2" Offset="0.58" />
                  <GradientStop Color="#FF2EA4FF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="23" Background="#32FFFFFF">
                  <ui:SymbolIcon Symbol="HeartCircle24" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                  <TextBlock Text="Apoie o projeto" FontSize="18" FontWeight="Bold" Foreground="White" />
                  <TextBlock Text="Ajude a manter o DLuzMObi v2 em desenvolvimento" Margin="0,3,0,0" FontSize="12" Foreground="#E8FFFFFF" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="livepix.gg/dluz" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="White" />
                  <ui:SymbolIcon Symbol="Open24" FontSize="20" Foreground="White" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ApoiarBg" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ApoiarBg" Property="Opacity" Value="0.8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
      <TextBlock Text="Canais oficiais" FontSize="16" FontWeight="SemiBold" Margin="2,4,0,12" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
      <WrapPanel>
        <Button Style="{StaticResource TileButton}" CommandParameter="{x:Static helpers:AppLinks.Oficial}" Command="{Binding AbrirUrlCommand}">
          <StackPanel>
            <ui:SymbolIcon Symbol="Earth24" FontSize="22" Foreground="{DynamicResource Stex.AccentLightBrush}" />
            <TextBlock Text="Página oficial" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <TextBlock Text="dluzgames.com.br" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource TileButton}" CommandParameter="{x:Static helpers:AppLinks.YouTube}" Command="{Binding AbrirUrlCommand}">
          <StackPanel>
            <ui:SymbolIcon Symbol="PlayCircle24" FontSize="22" Foreground="{DynamicResource Stex.AccentLightBrush}" />
            <TextBlock Text="YouTube" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <TextBlock Text="@dluzgames" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource TileButton}" CommandParameter="{x:Static helpers:AppLinks.TikTok}" Command="{Binding AbrirUrlCommand}">
          <StackPanel>
            <ui:SymbolIcon Symbol="MusicNote124" FontSize="22" Foreground="{DynamicResource Stex.AccentLightBrush}" />
            <TextBlock Text="TikTok" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <TextBlock Text="@dluzgames" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource TileButton}" CommandParameter="{x:Static helpers:AppLinks.Instagram}" Command="{Binding AbrirUrlCommand}">
          <StackPanel>
            <ui:SymbolIcon Symbol="Camera24" FontSize="22" Foreground="{DynamicResource Stex.AccentLightBrush}" />
            <TextBlock Text="Instagram" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <TextBlock Text="@dluzgames" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

