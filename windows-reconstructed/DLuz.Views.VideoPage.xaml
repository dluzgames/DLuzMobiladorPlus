<Page x:Class="DLuz.Views.VideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:DLuz.Controls"
      xmlns:helpers="clr-namespace:DLuz.Helpers"
      Title="Vídeo e Áudio">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="32,24,32,32" helpers:ScrollReset.ResetOnShow="True">
      <StackPanel>
        <TextBlock Text="Vídeo e Áudio" Style="{StaticResource Stex.PageTitle}" />
        <TextBlock Text="Codec, FPS, bitrate, codificador, DLSS 5 AI e renderização." Margin="0,4,0,16" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
        
        <ctl:KofiCta Text="Precisa de uma configuração personalizada? Disponível no Ko-fi" />
        
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <ui:SymbolIcon Symbol="Info24" VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource Stex.WarningTextBrush}" />
          <TextBlock Margin="8,0,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Stex.WarningTextBrush}" Text="Se a tela não abrir, verifique o codificador ou a configuração de renderização. A compatibilidade depende do aparelho, cabo e modo de conexão." />
        </StackPanel>

        <!-- Card: Resolução nativa do aparelho -->
        <ui:Card Margin="0,0,0,16" Padding="20,18">
          <StackPanel>
            <TextBlock Text="Resolução nativa do aparelho" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
              <TextBlock Text="Largura:" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <TextBlock Margin="6,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF2A3A" Text="{Binding ResAncho}" />
              <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Margin="6,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF2A3A" Text="{Binding ResAlto}" />
              <ui:Button Margin="16,0,0,0" ToolTip="Detectar resolução" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding DetectarResolucionCommand}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding ResStatus}" />
          </StackPanel>
        </ui:Card>

        <!-- Card: Configuração de vídeo -->
        <ui:Card Margin="0,0,0,16" Padding="20,18">
          <StackPanel>
            <Grid>
              <TextBlock Text="Configuração de vídeo" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <ui:ToggleSwitch HorizontalAlignment="Right" Content="Ativar vídeo" IsChecked="{Binding S.Video, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="FPS (máx. 240)" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <Slider Grid.Column="1" Minimum="30" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding S.Fps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding S.Fps}" />
            </Grid>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Bitrate (Mb)" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <Slider Grid.Column="1" Minimum="1" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding S.Bitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding S.Bitrate}" />
            </Grid>
            <TextBlock Text="Limitador de resolução (0 = sem limite)" Margin="0,14,0,4" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal">
              <ui:NumberBox Minimum="0" Maximum="4000" SmallChange="100" Width="160" HorizontalAlignment="Left" Value="{Binding S.MaxSize, Mode=TwoWay}" IsEnabled="{Binding MaxSizeHabilitado}" />
              <TextBlock Text="⚠ Desativado (tela virtual ativa)" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Stex.WarningOrangeBrush}" Visibility="{Binding AvisoMaxSizeDexVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Text="Codificador de vídeo" Margin="0,14,0,4" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal">
              <ComboBox Width="140" ItemsSource="{Binding Codecs}" SelectedItem="{Binding S.VideoCodec, Mode=TwoWay}" IsEnabled="{Binding CodecHabilitado}" />
              <TextBlock Text="⚠ Desativado (usando codificador avançado)" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Stex.WarningOrangeBrush}" Visibility="{Binding AvisoCodecDesactivadoVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding DescripcionCodec}" />
            <TextBlock Text="Buffer de vídeo (ms), 0 = menor latência" Margin="0,14,0,4" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <ui:NumberBox Minimum="0" Maximum="500" SmallChange="10" Width="160" HorizontalAlignment="Left" Value="{Binding S.VideoBuffer, Mode=TwoWay}" />
          </StackPanel>
        </ui:Card>

        <!-- Card: Aceleração por Hardware -->
        <ui:Card Margin="0,0,0,16" Padding="20,18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Aceleração por hardware" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <Border Background="{DynamicResource Stex.AccentBrush}" CornerRadius="5" Padding="7,1" Margin="10,2,0,0" Height="20" VerticalAlignment="Center">
                  <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Usa a placa de vídeo conectada diretamente à tela (DirectX 11/12). Garante taxa máxima de quadros e menor consumo de CPU." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
              <TextBlock Text="⚠ Requer vídeo ativo" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Stex.WarningOrangeBrush}" Visibility="{Binding AvisoAceleracionSinVideoVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" ToolTip="Depende da placa de vídeo do computador. Requer vídeo ativo." IsChecked="{Binding S.AceleracionHardware, Mode=TwoWay}" IsEnabled="{Binding AceleracionHabilitada}" />
          </Grid>
        </ui:Card>

        <!-- Card: DLSS 5 Ultra AI Mode -->
        <ui:Card Margin="0,0,0,16" Padding="20,18" BorderBrush="#38EF7D" BorderThickness="1.2">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Sparkle24" Foreground="#38EF7D" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="DLSS 5 Ultra AI Mode (Ray Reconstruction &amp; Upscaling)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <Border Background="#38EF7D" CornerRadius="5" Padding="7,1" Margin="10,2,0,0" Height="20" VerticalAlignment="Center">
                  <TextBlock Text="DLSS 5" FontSize="10" FontWeight="Bold" Foreground="#000000" />
                </Border>
              </StackPanel>
              <TextBlock Text="Aplica Super Resolution, Ray Reconstruction e Frame Generation por IA (DirectX 11/12) com zero delay (1ms) em todas as janelas de espelhamento e emuladores." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding S.Dlss5Modo, Mode=TwoWay}" />
          </Grid>
        </ui:Card>

        <!-- Card: Configuração de áudio -->
        <ui:Card Margin="0,0,0,16" Padding="20,18">
          <StackPanel>
            <Grid>
              <TextBlock Text="Configuração de áudio" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <ui:ToggleSwitch HorizontalAlignment="Right" Content="Ativar áudio" IsChecked="{Binding S.Audio, Mode=TwoWay}" />
            </Grid>
            <TextBlock Text="Transmite o áudio do celular ao PC junto com a tela." Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            <ctl:SettingRow Margin="0,14,0,0" IsSubOption="True" Title="Áudio duplicado" Description="Mantém o som também no celular durante a transmissão para o PC. Útil com fones no Android 13 ou superior; só funciona com o áudio ativado.">
              <ctl:SettingRow.Action>
                <ui:ToggleSwitch IsChecked="{Binding S.AudioDoble, Mode=TwoWay}" IsEnabled="{Binding S.Audio}" />
              </ctl:SettingRow.Action>
            </ctl:SettingRow>
            <TextBlock Text="Codificador de áudio" Margin="0,14,0,4" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <ComboBox Width="140" HorizontalAlignment="Left" ItemsSource="{Binding AudioCodecs}" SelectedItem="{Binding S.AudioCodec, Mode=TwoWay}" />
            <TextBlock Text="Bitrate (Kbps), default 128" Margin="0,14,0,4" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <ui:NumberBox Minimum="32" Maximum="320" SmallChange="8" Width="160" HorizontalAlignment="Left" Value="{Binding S.AudioBitrate, Mode=TwoWay}" />
            <TextBlock Text="Buffer de áudio (ms), padrão 50" Margin="0,14,0,4" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <ui:NumberBox Minimum="0" Maximum="500" SmallChange="10" Width="160" HorizontalAlignment="Left" Value="{Binding S.AudioBuffer, Mode=TwoWay}" />
          </StackPanel>
        </ui:Card>

        <!-- Card: Codificador avançado -->
        <ui:Card Margin="0,0,0,16" Padding="20,18">
          <StackPanel>
            <Grid>
              <TextBlock Text="Codificador avançado" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding S.UseAdvancedEncoder, Mode=TwoWay}" />
            </Grid>
            <TextBlock Text="Usa um codificador específico do aparelho quando o codec genérico apresenta problemas." Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" ItemsSource="{Binding EncoderLabels}" SelectedIndex="{Binding SelectedEncoderIndex, Mode=TwoWay}" IsEnabled="{Binding EncoderControlesHabilitados}" />
              <ui:Button Grid.Column="1" Content="Detectar" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding DetectarEncodersCommand}" IsEnabled="{Binding EncoderControlesHabilitados}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Stex.SuccessBrush}" Text="{Binding EncoderStatus}" />
            <TextBlock Margin="0,2,0,0" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding EncoderActivo}" />
          </StackPanel>
        </ui:Card>

        <!-- Card: Modo de renderização -->
        <ui:Card Margin="0,0,0,16" Padding="20,18">
          <StackPanel>
            <TextBlock Text="Modo de renderização" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <ComboBox Width="300" HorizontalAlignment="Left" MaxDropDownHeight="320" helpers:ComboGuard.ProtegerApertura="True" DisplayMemberPath="Texto" ItemsSource="{Binding RenderOpciones}" SelectedItem="{Binding SelectedRenderOpcion, Mode=TwoWay}" IsEnabled="{Binding RenderHabilitado}" />
              <TextBlock Text="⚠ Desativado (aceleração por hardware ativa)" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Stex.WarningOrangeBrush}" Visibility="{Binding AvisoRenderAceleracionVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding DescripcionRender}" />
          </StackPanel>
        </ui:Card>

        <!-- Card: Tela virtual (modo DeX) -->
        <ui:Card Margin="0,0,0,16" Padding="20,18">
          <StackPanel>
            <Grid>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tela virtual (modo DeX)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource Stex.WarningSoftBrush}" BorderBrush="{DynamicResource Stex.WarningTextBrush}" BorderThickness="1">
                  <TextBlock Text="Depende do celular" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Stex.WarningTextBrush}" />
                </Border>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding S.PantallaVirtualDex, Mode=TwoWay}" IsEnabled="{Binding DexHabilitado}" />
            </Grid>
            <TextBlock Text="Transmite uma área de trabalho virtual independente do celular (como o Samsung DeX). Abra o jogo pelo inicializador da janela." Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            <TextBlock Text="Nem todos os celulares oferecem área de trabalho para telas adicionais. Tela preta ou comportamento estranho indica uma limitação do aparelho que não pode ser corrigida pelo aplicativo." Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            <TextBlock Text="Desative o modo dual experimental (Espelhar) ou o modo OTG (Conexão) para usar esta função." Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Stex.WarningTextBrush}" Visibility="{Binding DexBloqueadoAvisoVisible, Converter={StaticResource BoolToVis}}" />
            <StackPanel Visibility="{Binding S.PantallaVirtualDex, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Resolução da tela virtual:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
                <ComboBox Width="140" ItemsSource="{Binding ResolucionesDex}" SelectedItem="{Binding S.PantallaVirtualResolucion, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
