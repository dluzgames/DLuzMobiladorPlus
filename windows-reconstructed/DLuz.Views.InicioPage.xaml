<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DLuz.Views.InicioPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:ctl="clr-namespace:DLuz.Controls" xmlns:helpers="clr-namespace:DLuz.Helpers" Title="Espelhar" xmlns:views="clr-namespace:DLuz.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32" helpers:ScrollReset.ResetOnShow="True">
    <StackPanel>
      <ctl:KofiCta Text="Precisa de ajuda para configurar seu aparelho? Confira as opções no Ko-fi" />
      <Border CornerRadius="12" Padding="28,24" Margin="0,0,0,20">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Stex.AccentDeepColor}" Offset="0" />
            <GradientStop Color="{StaticResource Stex.AccentColor}" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="DluzMobiladorPlus" FontSize="30" FontWeight="Bold" Foreground="#FFFFFFFF" />
              <Border Background="#141E38" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Flash24" FontSize="12" Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Text="Latência Mínima: ~8ms a 12ms (Vídeo 120 FPS USB)" FontSize="11" FontWeight="Bold" Foreground="#00E676" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="Transmissão USB 120 FPS Zero Delay para GG Mouse Pro e Modo Produtividade." FontSize="13.5" Foreground="{DynamicResource Stex.AccentPaleBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="220">
            <Button Style="{StaticResource Stex.ActionButton}" HorizontalAlignment="Stretch" Height="44" Command="{Binding IniciarScrcpyCommand}" IsEnabled="{Binding PuedeIniciar}" Background="{Binding IniciarFill}" Foreground="{Binding IniciarFore}">
              <StackPanel Orientation="Horizontal" TextElement.Foreground="{Binding IniciarFore}">
                <ui:SymbolIcon Symbol="Play24" VerticalAlignment="Center" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding BotonIniciarTexto}" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Stex.ActionButton}" HorizontalAlignment="Stretch" Height="40" Margin="0,10,0,0" Command="{Binding DetenerScrcpyCommand}" IsEnabled="{Binding EstaCorriendo}" Background="{Binding DetenerFill}" Foreground="{Binding DetenerFore}">
              <StackPanel Orientation="Horizontal" TextElement.Foreground="{Binding DetenerFore}">
                <ui:SymbolIcon Symbol="Stop24" VerticalAlignment="Center" />
                <TextBlock Text="PARAR ESPELHAMENTO" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Card: Auto Configuração Inteligente (1-Clique) -->
      <Border Margin="0,0,0,16" Padding="18,14" CornerRadius="8" Background="#161E38" BorderBrush="#00E676" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
              <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Calibração Automática de Desempenho (Auto-Tuning)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
            </StackPanel>
            <TextBlock Text="Detecta o modelo do celular, processador, resolução e taxa de Hz da tela, aplicando a melhor configuração para 120 FPS e Zero Delay automaticamente." FontSize="12" Foreground="#AEB8DE" TextWrapping="Wrap" />
          </StackPanel>
          <ui:Button Grid.Column="1" Content="⚡ Auto Configurar Celular" Appearance="Primary" Height="40" Padding="16,0" FontWeight="Bold" Command="{Binding AutoConfigurarCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Card: Central de Tutoriais & Aulas em Vídeo -->
      <Border Margin="0,0,0,16" Padding="18,12" CornerRadius="8" Background="#131B33" BorderBrush="#2F4278" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
              <ui:SymbolIcon Symbol="VideoClip24" FontSize="16" Foreground="#FF3D71" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Aprenda em 2 minutos: Tutoriais &amp; Aulas Práticas" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
            </StackPanel>
            <TextBlock Text="Assista aos vídeos rápidos de como ativar a depuração, calibrar a melhor sensibilidade e mapear o Free Fire / FPS." FontSize="12" Foreground="#8FA0D1" TextWrapping="Wrap" />
          </StackPanel>
          <ui:Button Grid.Column="1" Content="🎓 Ver Tutoriais" Appearance="Secondary" Height="36" Padding="14,0" FontWeight="SemiBold" Command="{Binding AbrirTutoriaisCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Margin="0,0,0,16" Padding="14,10" CornerRadius="8" Background="{DynamicResource Stex.BgCardBrush}" BorderBrush="{DynamicResource Stex.AccentLightBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Warning24" VerticalAlignment="Center" Foreground="{DynamicResource Stex.AccentLightBrush}" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="MOD + Q fecha o espelhamento" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <TextBlock Text="MOD é a tecla modificadora de atalhos, normalmente Alt esquerdo. Evite pressionar essa combinação por acidente durante a sessão." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource Stex.AccentLightBrush}" />
              <TextBlock Text="Modo duplo experimental" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            </StackPanel>
            <TextBlock Text="Executa tela, áudio e controles em processos separados. Usa o perfil ativo e altera somente o modo de execução." Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
            <TextBlock Text="Desative a tela virtual (modo DeX) em Vídeo e Áudio para usar o modo duplo." Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Stex.WarningTextBrush}" Visibility="{Binding DualBloqueadoAvisoVisible, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <ui:ToggleSwitch Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ModoDualExperimental, Mode=TwoWay}" IsEnabled="{Binding DualHabilitado}" />
        </Grid>
      </ui:Card>
      <ui:Card Margin="0,0,0,16" Padding="20,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Perfil ativo" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
            <ComboBox Name="ComboPerfil" Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" helpers:ComboGuard.ProtegerApertura="True" ItemsSource="{Binding PerfilesDisponibles}" SelectedItem="{Binding PerfilActivoNombre, Mode=TwoWay}" DropDownOpened="ComboPerfil_DropDownOpened" />
            <ui:Button Grid.Column="2" Content="Gerenciar perfis" Icon="{ui:SymbolIcon Folder24}" Command="{Binding AdministrarPerfilesCommand}" />
          </Grid>
          <Border Height="1" Margin="0,14" Background="{DynamicResource Stex.BorderNeutralBrush}" />
          <Grid>
            <TextBlock Text="⚠  Alterações não salvas; abra Gerenciar perfis para salvá-las" FontWeight="SemiBold" Foreground="{DynamicResource Stex.WarningBrush}" Visibility="Collapsed">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding HayCambios}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <WrapPanel>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type WrapPanel}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding HayCambios}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                <TextBlock Text="FPS:" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding ChipFps}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                <TextBlock Text="Mb:" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding ChipMb}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                <TextBlock Text="Codec:" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" Text="{Binding ChipCodec}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Modo:" Foreground="{DynamicResource Stex.TextSecondaryBrush}" />
                <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Stex.SuccessBrightBrush}" Text="{Binding ChipModo}" />
              </StackPanel>
            </WrapPanel>
          </Grid>
        </StackPanel>
      </ui:Card>
      <ui:Card Margin="0,0,0,16" Padding="20,18">
        <StackPanel>
                        <TextBlock Text="Estado do aparelho" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Stex.TextPrimaryBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding IndicadorBrush}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Stex.TextSecondaryBrush}" Text="{Binding EstadoTexto}" />
          </StackPanel>
          <ui:Button Content="Reconectar ADB" Margin="0,14,0,0" Command="{Binding ReconectarAdbCommand}" Appearance="{Binding ReconectarAppearance}" Icon="{ui:SymbolIcon ArrowSync24}" />
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</Page>



